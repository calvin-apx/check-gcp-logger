# Copy this file to .env and fill in the values.
# The server picks these up at startup; restart `npm run dev` if you change them.

# Required: which GCP project's Cloud Functions to inspect
GCP_PROJECT_ID=motenasu-develop

# Region the Cloud Functions are deployed in
GCP_REGION=asia-northeast1

# Server port (the Vite dev server proxies /api/* to here)
PORT=4000

# Cap on entries returned per query (request can ask for less but not more)
MAX_LOG_ENTRIES_PER_QUERY=500

# ─── Docker mode only (ignore these for plain `npm run dev`) ──────────────────

# ngrok auth token. Get one for free at https://dashboard.ngrok.com/get-started/your-authtoken
# Without this, the `ngrok` service in docker-compose will refuse to start.
NGROK_AUTHTOKEN=

# Path to your ADC credentials file on the host. The compose file mounts this
# into the app container so google-cloud libraries can authenticate.
#
# Default (auto-detected):
#   Windows: %APPDATA%\gcloud\application_default_credentials.json
#   macOS/Linux: $HOME/.config/gcloud/application_default_credentials.json
#
# Override only if your gcloud config lives somewhere non-standard.
GCLOUD_ADC_FILE=
# Named Firestore database browsed by the Firestore tab.
FIRESTORE_DATABASE_ID=ga4-analytics-db-dev
